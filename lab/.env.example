# cp .env.example .env  і заповни. Файл .env у .gitignore, ключі в код і звіт не потрапляють.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite     # генератор RAG і суддя дублікатів
JUDGE_MODEL=gemini-3.5-flash           # суддя faithfulness (інша модель, ніж генератор)
SEED=42
KB_VARIANT=baseline                    # baseline | clean (Результат 5 запускає з clean)
