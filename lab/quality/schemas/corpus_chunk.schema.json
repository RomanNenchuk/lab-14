{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Фрагмент корпусу (corpus.jsonl)",
  "type": "object",
  "required": [
    "chunk_id",
    "doc_id",
    "title",
    "section",
    "type",
    "date",
    "sensitivity",
    "source_url",
    "lang",
    "license",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+#\\d{3}$"
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "lang": {
      "enum": [
        "en",
        "uk"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_url": {
            "pattern": "wikipedia\\.org"
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "const": "CC BY-SA 4.0"
          },
          "sensitivity": {
            "const": "public"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "license": {
            "const": "own work"
          }
        },
        "required": [
          "license"
        ]
      },
      "then": {
        "properties": {
          "source_url": {
            "pattern": "^(internal|file)://"
          }
        }
      }
    }
  ]
}
